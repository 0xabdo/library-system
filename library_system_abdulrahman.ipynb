   "cell_type": "markdown",
   "id": "d05d345c",
   "metadata": {},
   "source": [
    "## 4. Library class"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cbecbec9",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Library:\n",
    "    def __init__(self, name):\n",
    "        self.name = name\n",
    "        # Dictionaries make ID lookup and duplicate checks straightforward.\n",
    "        self.books = {}\n",
    "        self.members = {}\n",
    "\n",
    "    def add_book(self, book):\n",
    "        if book.book_id in self.books:\n",
    "            return False, \"A book with this ID already exists.\"\n",
    "        self.books[book.book_id] = book\n",
    "        return True, \"Book added successfully.\"\n",
    "\n",
    "    def register_member(self, member):\n",
    "        if member.member_id in self.members:\n",
    "            return False, \"A member with this ID already exists.\"\n",
    "        self.members[member.member_id] = member\n",
    "        return True, \"Member registered successfully.\"\n",
    "\n",
    "    def find_book(self, query):\n",
    "        query = str(query).strip().lower()\n",
    "        return [\n",
    "            book for book in self.books.values()\n",
    "            if query in book.book_id.lower()\n",
    "            or query in book.title.lower()\n",
    "            or query in book.author.lower()\n",
    "        ]\n",
    "\n",
    "    def display_available_books(self):\n",
    "        available = [b for b in self.books.values() if b.is_available()]\n",
    "        if not available:\n",
    "            print(\"No books are currently available.\")\n",
    "        else:\n",
    "            for book in available:\n",
    "                print(book)\n",
    "\n",
    "    def lend_book(self, member_id, book_id):\n",
    "        member = self.members.get(str(member_id))\n",
    "        book = self.books.get(str(book_id))\n",
    "        if member is None:\n",
    "            return False, \"Member ID not found.\"\n",
    "        if book is None:\n",
    "            return False, \"Book ID not found.\"\n",
    "        return member.borrow_book(book)\n",
    "\n",
    "    def receive_return(self, member_id, book_id):\n",
    "        member = self.members.get(str(member_id))\n",
    "        book = self.books.get(str(book_id))\n",
    "        if member is None:\n",
    "            return False, \"Member ID not found.\"\n",
    "        if book is None:\n",
    "            return False, \"Book ID not found.\"\n",
    "        return member.return_book(book)\n",
    "\n",
    "    def save_data(self, filename=DATA_FILE):\n",
    "        data = {\n",
    "            \"library_name\": self.name,\n",
    "            \"books\": [\n",
    "                {\n",
    "                    \"book_id\": b.book_id,\n",
    "                    \"title\": b.title,\n",
    "                    \"author\": b.author,\n",
    "                    \"is_available\": b.is_available()\n",
    "                }\n",
    "                for b in self.books.values()\n",
    "            ],\n",
    "            \"members\": [\n",
    "                {\n",
    "                    \"member_id\": m.member_id,\n",
    "                    \"name\": m.name,\n",
    "                    \"type\": \"premium\" if isinstance(m, PremiumMember) else \"regular\",\n",
    "                    \"borrowed_book_ids\": [b.book_id for b in m.list_borrowed_books()]\n",
    "                }\n",
    "                for m in self.members.values()\n",
    "            ]\n",
    "        }\n",
    "        with open(filename, \"w\", encoding=\"utf-8\") as file:\n",
    "            json.dump(data, file, indent=4, ensure_ascii=False)\n",
    "\n",
    "    @classmethod\n",
    "    def load_data(cls, filename=DATA_FILE):\n",
    "        with open(filename, \"r\", encoding=\"utf-8\") as file:\n",
    "            data = json.load(file)\n",
    "\n",
    "        library = cls(data.get(\"library_name\", \"My Library\"))\n",
    "        for item in data.get(\"books\", []):\n",
    "            library.add_book(Book(\n",
    "                item[\"book_id\"], item[\"title\"], item[\"author\"],\n",
    "                item.get(\"is_available\", True)\n",
    "            ))\n",
    "\n",
    "        borrowed_by_member = []\n",
    "        for item in data.get(\"members\", []):\n",
    "            member_class = PremiumMember if item.get(\"type\") == \"premium\" else Member\n",
    "            member = member_class(item[\"member_id\"], item[\"name\"])\n",
    "            library.register_member(member)\n",
    "            borrowed_by_member.append((member, item.get(\"borrowed_book_ids\", [])))\n",
    "\n",
    "        # Rebuild the member-book relationships after all objects exist.\n",
    "        for member, book_ids in borrowed_by_member:\n",
    "            for book_id in book_ids:\n",
    "                book = library.books.get(str(book_id))\n",
    "                if book is not None and not book.is_available():\n",
    "                    member._borrowed_books.append(book)\n",
    "\n",
    "        return library"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a4086b14",
   "metadata": {},
   "source": [
    "## 5. Create sample data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5d8342e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_sample_library():\n",
    "    library = Library(\"Knowledge Hub Library\")\n",
    "\n",
    "    sample_books = [\n",
    "        Book(\"B101\", \"Python Crash Course\", \"Eric Matthes\"),\n",
    "        Book(\"B102\", \"Clean Code\", \"Robert C. Martin\"),\n",
    "        Book(\"B103\", \"The Pragmatic Programmer\", \"Andrew Hunt\")\n",
    "    ]\n",
    "\n",
    "    sample_members = [\n",
    "        Member(\"M101\", \"Ahmed Ali\"),\n",
    "        PremiumMember(\"M102\", \"Sara Hassan\")\n",
    "    ]\n",
    "\n",
    "    for book in sample_books:\n",
    "        library.add_book(book)\n",
    "    for member in sample_members:\n",
    "        library.register_member(member)\n",
    "\n",
    "    return library\n",
    "\n",
    "\n",
    "library = create_sample_library()\n",
    "print(library.name)\n",
    "print(\"Books:\", len(library.books))\n",
    "print(\"Members:\", len(library.members))"
   ]
  },
