   "source": [
    "## 6. Interactive menu"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a4733f35",
   "metadata": {},
   "outputs": [],
   "source": [
    "def show_member_books(library, member_id):\n",
    "    member = library.members.get(str(member_id))\n",
    "    if member is None:\n",
    "        print(\"Member ID not found.\")\n",
    "        return\n",
    "\n",
    "    print(member)\n",
    "    borrowed = member.list_borrowed_books()\n",
    "    if not borrowed:\n",
    "        print(\"This member has no borrowed books.\")\n",
    "    else:\n",
    "        for book in borrowed:\n",
    "            print(book)\n",
    "\n",
    "\n",
    "def main():\n",
    "    global library\n",
    "\n",
    "    while True:\n",
    "        print(\"\\\\n========== LIBRARY MENU ==========\")\n",
    "        print(\"1. View Available Books\")\n",
    "        print(\"2. Search for a Book\")\n",
    "        print(\"3. Add Book\")\n",
    "        print(\"4. Register Member\")\n",
    "        print(\"5. Borrow Book\")\n",
    "        print(\"6. Return Book\")\n",
    "        print(\"7. View Member's Books\")\n",
    "        print(\"8. Save Data\")\n",
    "        print(\"9. Load Data\")\n",
    "        print(\"0. Exit\")\n",
    "\n",
    "        try:\n",
    "            choice = input(\"Choose an option: \").strip()\n",
    "\n",
    "            if choice == \"1\":\n",
    "                library.display_available_books()\n",
    "\n",
    "            elif choice == \"2\":\n",
    "                query = input(\"Enter book ID, title, or author: \").strip()\n",
    "                results = library.find_book(query)\n",
    "                if results:\n",
    "                    for book in results:\n",
    "                        print(book)\n",
    "                else:\n",
    "                    print(\"No matching books found.\")\n",
    "\n",
    "            elif choice == \"3\":\n",
    "                book_id = input(\"Book ID: \").strip()\n",
    "                title = input(\"Book title: \").strip()\n",
    "                author = input(\"Author: \").strip()\n",
    "                if not book_id or not title or not author:\n",
    "                    print(\"All fields are required.\")\n",
    "                    continue\n",
    "                success, message = library.add_book(Book(book_id, title, author))\n",
    "                print(message)\n",
    "\n",
    "            elif choice == \"4\":\n",
    "                member_id = input(\"Member ID: \").strip()\n",
    "                name = input(\"Member name: \").strip()\n",
    "                if not member_id or not name:\n",
    "                    print(\"All fields are required.\")\n",
    "                    continue\n",
    "                member_type = input(\"Member type (1 = Regular, 2 = Premium): \").strip()\n",
    "                if member_type == \"1\":\n",
    "                    member = Member(member_id, name)\n",
    "                elif member_type == \"2\":\n",
    "                    member = PremiumMember(member_id, name)\n",
    "                else:\n",
    "                    print(\"Invalid member type.\")\n",
    "                    continue\n",
    "                success, message = library.register_member(member)\n",
    "                print(message)\n",
    "\n",
    "            elif choice == \"5\":\n",
    "                member_id = input(\"Member ID: \").strip()\n",
    "                book_id = input(\"Book ID: \").strip()\n",
    "                success, message = library.lend_book(member_id, book_id)\n",
    "                print(message)\n",
    "\n",
    "            elif choice == \"6\":\n",
    "                member_id = input(\"Member ID: \").strip()\n",
    "                book_id = input(\"Book ID: \").strip()\n",
    "                success, message = library.receive_return(member_id, book_id)\n",
    "                print(message)\n",
    "\n",
    "            elif choice == \"7\":\n",
    "                member_id = input(\"Member ID: \").strip()\n",
    "                show_member_books(library, member_id)\n",
    "\n",
    "            elif choice == \"8\":\n",
    "                filename = input(f\"Filename (Enter for {DATA_FILE}): \").strip() or DATA_FILE\n",
    "                library.save_data(filename)\n",
    "                print(f\"Data saved to {filename}.\")\n",
    "\n",
    "            elif choice == \"9\":\n",
    "                filename = input(f\"Filename (Enter for {DATA_FILE}): \").strip() or DATA_FILE\n",
    "                library = Library.load_data(filename)\n",
    "                print(f\"Data loaded from {filename}.\")\n",
    "\n",
    "            elif choice == \"0\":\n",
    "                print(\"Thank you for using the library system.\")\n",
    "                break\n",
    "\n",
    "            else:\n",
    "                print(\"Invalid option. Please choose a listed number.\")\n",
    "\n",
    "        except (ValueError, TypeError) as error:\n",
    "            print(f\"Invalid input: {error}\")\n",
    "        except (OSError, json.JSONDecodeError, KeyError) as error:\n",
    "            print(f\"Could not read or write the data file: {error}\")\n",
    "        except Exception as error:\n",
    "            # Final safeguard so an unexpected input/runtime issue doesn't kill the menu.\n",
    "            print(f\"An unexpected error occurred: {error}\")\n",
    "\n",
    "\n",
    "# Uncomment the next line to start the interactive program:\n",
    "# main()"
   ]
  },
