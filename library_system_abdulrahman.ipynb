   "source": [
    "## 7. Quick tests (run before starting the menu)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1f8da309",
   "metadata": {},
   "outputs": [],
   "source": [
    "# These tests use a separate test library so the sample data stays unchanged.\n",
    "test_library = create_sample_library()\n",
    "\n",
    "# Successful borrowing\n",
    "ok, message = test_library.lend_book(\"M101\", \"B101\")\n",
    "assert ok is True\n",
    "assert test_library.books[\"B101\"].is_available() is False\n",
    "\n",
    "# A second member cannot borrow an unavailable book\n",
    "ok, message = test_library.lend_book(\"M102\", \"B101\")\n",
    "assert ok is False\n",
    "\n",
    "# Successful return by the member who borrowed it\n",
    "ok, message = test_library.receive_return(\"M101\", \"B101\")\n",
    "assert ok is True\n",
    "assert test_library.books[\"B101\"].is_available() is True\n",
    "\n",
    "# Duplicate ID is rejected\n",
    "ok, message = test_library.add_book(Book(\"B101\", \"Duplicate\", \"Unknown\"))\n",
    "assert ok is False\n",
    "\n",
    "# Polymorphism: regular limit is 3; premium limit is 5\n",
    "assert test_library.members[\"M101\"].get_borrow_limit() == 3\n",
    "assert test_library.members[\"M102\"].get_borrow_limit() == 5\n",
    "\n",
    "print(\"All quick tests passed.\")"
   ]
